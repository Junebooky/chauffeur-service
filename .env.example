# Defaults support local development and popular-location search without credentials.
PORT=3001
HOST=0.0.0.0
# Optional absolute path to the persistent SQLite file:
# DATABASE_PATH=/workspace/chauffeur-service/.data/reservations.sqlite
# Enable Google Places API (New) on a billing-enabled Google Cloud project.
# Keep the key on the server only. Restrict it to Places API (New).
# Without a key, only the labelled local popular-location directory is searched.
# GOOGLE_MAPS_API_KEY=

# Production booking notifications use Gmail OAuth below; no SMTP app password required.
# SQLite-only legacy SMTP tests/compatibility (not the live Supabase mail path):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_APP_PASSWORD=
# SMTP_FROM_EMAIL=
# BOOKING_NOTIFICATION_TO=topcs2026@gmail.com

# Chauffeur Supabase (shared dating database; isolated chauffeur schema)
# Only the VITE_ values are exposed to the Vite browser build.
VITE_SUPABASE_URL=https://rvaowhriekibxtcpyalu.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_... (chauffeur_service key)
SUPABASE_URL=https://rvaowhriekibxtcpyalu.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server-only-production-secret (never commit)

# Gmail OAuth (server only; use scripts/setup-gmail.mjs locally)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/api/gmail/callback
# GMAIL_TOKEN_ENCRYPTION_KEY=64_hex_characters
# GMAIL_ALLOWED_EMAIL=topcs2026@gmail.com

# Defaults support local development and popular-location search without credentials.
PORT=3001
HOST=0.0.0.0
# Optional absolute path to the persistent SQLite file:
# DATABASE_PATH=/workspace/chauffeur-service/.data/reservations.sqlite
# Enable Google Places API (New) on a billing-enabled Google Cloud project.
# Keep the key on the server only. Restrict it to Places API (New).
# Without a key, only the labelled local popular-location directory is searched.
# GOOGLE_MAPS_API_KEY=

# Automatic booking notifications via Gmail SMTP + Nodemailer (server only).
# Create a Google App Password with two-step verification enabled.
# Never put an app password in Git, chat, or any VITE_ prefixed variable.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=gotoward7@gmail.com
# Set this secret in your server environment or Vercel project secrets:
# SMTP_APP_PASSWORD=your_16_character_app_password
# SMTP_FROM_EMAIL=gotoward7@gmail.com
BOOKING_NOTIFICATION_TO=gotoward7@gmail.com

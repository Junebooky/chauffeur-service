# Defaults support local development and popular-location search without credentials.
PORT=3001
HOST=0.0.0.0
# Optional absolute path to the persistent SQLite file:
# DATABASE_PATH=/workspace/chauffeur-service/.data/reservations.sqlite
# Enable Google Places API (New) on a billing-enabled Google Cloud project.
# Keep the key on the server only. Restrict it to Places API (New).
# Without a key, only the labelled local popular-location directory is searched.
# GOOGLE_MAPS_API_KEY=

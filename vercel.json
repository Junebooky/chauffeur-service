{
  "rewrites": [
    {
      "source": "/journal/sitemap.xml",
      "destination": "/api/journal?format=sitemap"
    },
    {
      "source": "/journal/:slug",
      "destination": "/api/journal?lang=en&slug=:slug"
    },
    {
      "source": "/journal",
      "destination": "/api/journal?lang=en"
    },
    {
      "source": "/ko/journal/:slug",
      "destination": "/api/journal?lang=ko&slug=:slug"
    },
    {
      "source": "/ko/journal",
      "destination": "/api/journal?lang=ko"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/index.html"
    },
    {
      "source": "/admin/live",
      "destination": "/index.html"
    },
    {
      "source": "/admin/live/",
      "destination": "/index.html"
    },
    {
      "source": "/ko",
      "destination": "/ko/index.html"
    },
    {
      "source": "/ko/",
      "destination": "/ko/index.html"
    },
    {
      "source": "/en",
      "destination": "/en/index.html"
    },
    {
      "source": "/en/",
      "destination": "/en/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "feature/seo-foundation": false,
      "feature/seo-integration": false
    }
  },
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
